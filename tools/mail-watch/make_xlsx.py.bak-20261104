# make_xlsx.py — 由 ledger.json 生成 Excel 汇总表（一次性执行，跑完退出）
# 口径（用户 m01347）：哪个项目的材料，汇总表就放到那个项目的文件夹里；主表另在 10 月根目录留一份总览。
import json, os, sys, time, datetime
from openpyxl import Workbook
from openpyxl.styles import Font, PatternFill, Alignment, Border, Side

BASE = r'D:\dsh-workbench\mail\126'
MONTH = r'E:\桌面\办公文件\办公文档\2026年\10月'
STAMP = datetime.datetime.now().strftime('%Y%m%d')
OUT_MAIN = os.path.join(MONTH, '邮件材料检查汇总表-%s.xlsx' % STAMP)

with open(os.path.join(BASE, 'ledger.json'), encoding='utf-8') as f:
    ledger = json.load(f)
rows = ledger['rows']

HEAD_FILL = PatternFill('solid', fgColor='1F4E78')
HEAD_FONT = Font(color='FFFFFF', bold=True, size=11)
THIN = Side(style='thin', color='BFBFBF')
BORDER = Border(left=THIN, right=THIN, top=THIN, bottom=THIN)
WRAP = Alignment(wrap_text=True, vertical='top')
CENTER = Alignment(horizontal='center', vertical='center', wrap_text=True)

VERDICT_FILL = {
    '可以给予通过': PatternFill('solid', fgColor='C6EFCE'),
    '可以给予通过（盖章页请人工确认）': PatternFill('solid', fgColor='C6EFCE'),
    '基本符合，需补正': PatternFill('solid', fgColor='FFEB9C'),
    '不符合，需补正': PatternFill('solid', fgColor='FFC7CE'),
    '未收到材料': PatternFill('solid', fgColor='F8CBAD'),
}

RULES = {
    '课间一刻钟AI应用案例': [
        ('课间一刻钟', '案例正文含六个模块（一背景二举措三成效四创新五优化〔选填〕六素材）', '缺正文/缺必备模块 → 需补正', '截止 2026-11-10 17:00，联系人杨衡、李妍 81487550'),
        ('课间一刻钟', '另附「学校报送联系人信息表」（附件1：学校名称/姓名/职务/联系电话）', '未附 → 需补正', '与案例材料一并报送'),
        ('课间一刻钟', '命名：学校名称－案例名称－材料名称；压缩包：学校名称－课间一刻钟AI应用案例', '命名不规范 → 提醒', '邮件主题宜与压缩包同名'),
        ('课间一刻钟', '需盖章者 docx + pdf 同名同报，不得用照片/扫描件代替 pdf', '仅照片 → 需补正', '电子版需可编辑'),
    ],
    '千问试用人员信息表': [
        ('千问试用', '试用人员信息表（附件3）电子表格 xlsx', '仅 doc/图片 → 不符合', '截止已过（10-19 17:00）'),
        ('千问试用', '单位名称（需盖章）；区级管理员姓名/部门/职务/手机', '字段缺失 → 需补正', '盖章为纸质页，需人工确认'),
        ('千问试用', '教师信息：序号/单位/姓名/职务学科/电话', '字段缺失 → 需补正', ''),
        ('千问试用', '盖章版 pdf 与电子表格同报', '缺 pdf → 提醒', ''),
    ],
    '其他': [
        ('其他', '未匹配到两个项目关键词的邮件', '需人工判断归属', '暂存 D:\\dsh-workbench\\mail\\126\\待确认'),
    ],
}


def sheet_title(ws, title, subtitle, ncol):
    ws.merge_cells(start_row=1, start_column=1, end_row=1, end_column=ncol)
    c = ws.cell(row=1, column=1, value=title)
    c.font = Font(bold=True, size=15)
    c.alignment = Alignment(horizontal='center', vertical='center')
    ws.row_dimensions[1].height = 30
    ws.merge_cells(start_row=2, start_column=1, end_row=2, end_column=ncol)
    c2 = ws.cell(row=2, column=1, value=subtitle)
    c2.font = Font(size=9, color='595959')
    c2.alignment = Alignment(horizontal='center', vertical='center')
    ws.row_dimensions[2].height = 22


def write_head(ws, headers, row=3):
    for i, h in enumerate(headers, 1):
        c = ws.cell(row=row, column=i, value=h)
        c.fill = HEAD_FILL
        c.font = HEAD_FONT
        c.alignment = CENTER
        c.border = BORDER
    ws.row_dimensions[row].height = 30


def widths(ws, mapping):
    for col, w in mapping.items():
        ws.column_dimensions[col].width = w


MAIN_HEADERS = ['序号', '类型', '学校（单位）', '题目 / 邮件主题', '发件人', '提交时间',
                '提交的文件', '包内文件数', '媒体素材数', '检查通过项', '需补正 / 不符合项', '结论']
MAIN_WIDTHS = {'A': 6, 'B': 20, 'C': 24, 'D': 44, 'E': 14, 'F': 22, 'G': 46, 'H': 10,
               'I': 10, 'J': 46, 'K': 40, 'L': 26}


def add_summary_sheet(wb, subset, title, subtitle):
    if '汇总' in wb.sheetnames:
        ws = wb.create_sheet('汇总')
    else:
        ws = wb.active          # 复用新建工作簿自带的空 Sheet，避免留下空表
    ws.title = '汇总'
    sheet_title(ws, title, subtitle, len(MAIN_HEADERS))
    write_head(ws, MAIN_HEADERS)
    counts = {}
    for idx, r in enumerate(subset, 1):
        counts[r['verdict']] = counts.get(r['verdict'], 0) + 1
        vals = [idx, r['type'], r['school'] or '（未识别）', r['title'], r['from'], r['time'],
                r['files'] or '（无附件）', r.get('innerCount') or 0, r.get('media') or 0,
                r.get('passes') or '', '；'.join(r.get('issues') or []), r['verdict']]
        for j, v in enumerate(vals, 1):
            c = ws.cell(row=3 + idx, column=j, value=v)
            c.border = BORDER
            c.alignment = WRAP if j in (3, 4, 7, 10, 11) else CENTER
        fill = VERDICT_FILL.get(r['verdict'])
        if fill:
            ws.cell(row=3 + idx, column=12).fill = fill
    widths(ws, MAIN_WIDTHS)
    ws.freeze_panes = 'A4'
    start = 4 + len(subset) + 1
    ws.cell(row=start, column=2, value='统计').font = Font(bold=True)
    for i, (k, v) in enumerate(sorted(counts.items(), key=lambda x: -x[1])):
        ws.cell(row=start + 1 + i, column=2, value=k).border = BORDER
        ws.cell(row=start + 1 + i, column=3, value=v).border = BORDER
    return counts


def add_kejian_sheet(wb, subset):
    ws = wb.create_sheet('课间一刻钟明细')
    h = ['学校（单位）', '题目（邮件主题）', '发件人', '提交时间', '提交文件', '包内文件数', '媒体素材数',
         '案例正文文档', '正文字数', '六大模块核查', '申报单位', '联系人/电话', '附件1 联系人信息表', '结论', '需补正项']
    sheet_title(ws, '课间一刻钟AI应用案例 · 逐份体检',
                '通知要求：2026-11-10 17:00 前报送　联系人杨衡、李妍 81487550　模块五（优化计划）为选填', len(h))
    write_head(ws, h)
    for i, r in enumerate(subset, 1):
        mods = '　'.join(('✓' if v else '✗') + m for m, v in (r.get('modules') or []))
        vals = [r['school'] or '（未识别）', r['title'], r['from'], r['time'], r['files'] or '（无附件）',
                r.get('innerCount') or 0, r.get('media') or 0, r.get('caseDoc') or '（未找到）',
                r.get('caseLen') or 0, mods,
                '有' if r.get('hasUnit') else '缺', '有' if r.get('hasContact') else '缺',
                '有' if r.get('hasContactSheet') else '缺', r['verdict'], '；'.join(r.get('issues') or [])]
        for j, v in enumerate(vals, 1):
            c = ws.cell(row=3 + i, column=j, value=v)
            c.border = BORDER
            c.alignment = WRAP if j in (1, 2, 5, 10, 15) else CENTER
        fill = VERDICT_FILL.get(r['verdict'])
        if fill:
            ws.cell(row=3 + i, column=14).fill = fill
    widths(ws, {'A': 24, 'B': 40, 'C': 14, 'D': 22, 'E': 40, 'F': 10, 'G': 10, 'H': 30, 'I': 10,
                'J': 40, 'K': 10, 'L': 10, 'M': 12, 'N': 22, 'O': 38})
    ws.freeze_panes = 'A4'


def add_qianwen_sheet(wb, subset):
    ws = wb.create_sheet('千问信息表明细')
    h = ['学校（单位）', '题目（邮件主题）', '发件人', '提交时间', '提交文件', '含单位名称', '含联系人/职务/手机', '含教师信息表', '结论', '需补正项']
    sheet_title(ws, '千问（人工智能赋能教育智能平台）试用人员信息表 · 逐份体检',
                '通知要求：附件3 电子表格 + 盖章 pdf　截止 10-19 17:00　收件邮箱 huangyinwenhui@bjedu.cn', len(h))
    write_head(ws, h)
    for i, r in enumerate(subset, 1):
        vals = [r['school'] or '（未识别）', r['title'], r['from'], r['time'], r['files'] or '（无附件）',
                '有' if r.get('hasUnit') else '缺', '有' if r.get('hasContact') else '缺',
                '有' if r.get('xlsxStrings') else '缺', r['verdict'], '；'.join(r.get('issues') or [])]
        for j, v in enumerate(vals, 1):
            c = ws.cell(row=3 + i, column=j, value=v)
            c.border = BORDER
            c.alignment = WRAP if j in (1, 2, 5, 10) else CENTER
        fill = VERDICT_FILL.get(r['verdict'])
        if fill:
            ws.cell(row=3 + i, column=9).fill = fill
    widths(ws, {'A': 26, 'B': 40, 'C': 16, 'D': 22, 'E': 42, 'F': 12, 'G': 18, 'H': 14, 'I': 26, 'J': 40})
    ws.freeze_panes = 'A4'


def add_rules_sheet(wb, key):
    ws = wb.create_sheet('检查判据')
    sheet_title(ws, '检查判据（据通知原文整理）', '本表用于解释“结论”列的依据，可按实际情况调整', 4)
    write_head(ws, ['项目', '通知要求要点', '一票否决 / 需补正', '备注'])
    r0 = 4
    for k, a, b, c in RULES.get(key, RULES['其他']):
        for j, v in enumerate([k, a, b, c], 1):
            cell = ws.cell(row=r0, column=j, value=v)
            cell.border = BORDER
            cell.alignment = WRAP
        r0 += 1
    widths(ws, {'A': 16, 'B': 56, 'C': 26, 'D': 30})


def save_book(wb, target):
    outdir = os.path.dirname(target)
    stem, ext = os.path.splitext(os.path.basename(target))
    os.makedirs(outdir, exist_ok=True)
    tmp = os.path.join(outdir, '.~writing%s' % ext)
    try:
        wb.save(tmp)
        os.replace(tmp, target)
        return target
    except (PermissionError, OSError) as e1:
        alt = os.path.join(outdir, '%s-%s%s' % (stem, time.strftime('%H%M'), ext))
        try:
            wb.save(alt)
            return alt
        except (PermissionError, OSError) as e2:
            print(json.dumps({'error': 'cannot save', 'target': target, 'detail': str(e2)}, ensure_ascii=False), file=sys.stderr)
            raise SystemExit(2)
    finally:
        if os.path.exists(tmp):
            try:
                os.remove(tmp)
            except OSError:
                pass


def project_of(r):
    t = r['type'] or ''
    if t.startswith('千问'):
        return 'qianwen'
    if t.startswith('课间一刻钟'):
        return 'kejian'
    if r.get('bucket') == 'archived':
        return 'archived'
    return 'other'


PROJECTS = [
    ('kejian', os.path.join(MONTH, '课件15分钟'), '课间一刻钟AI应用案例-汇总检查表-%s.xlsx' % STAMP,
     '课间一刻钟AI应用案例 · 材料检查汇总', '数据来源：126 邮箱收件箱；判据：区智慧教育发展促进中心 2026-10-20 通知'),
    ('qianwen', os.path.join(MONTH, '千问账号发送'), '千问试用人员信息表-汇总检查表-%s.xlsx' % STAMP,
     '千问试用人员信息表 · 材料检查汇总', '数据来源：126 邮箱收件箱；判据：市教委 2026-10-09 通知（附件3）'),
    ('other', MONTH, '其他邮件材料-汇总检查表-%s.xlsx' % STAMP,
     '其他邮件材料 · 汇总', '未匹配到「千问 / 课间一刻钟」的邮件，需人工判断归属'),
]

now_text = datetime.datetime.now().strftime('%Y-%m-%d %H:%M')
saved = []
for key, folder, fname, title, subtitle in PROJECTS:
    subset = [r for r in rows if project_of(r) == key]
    if key == 'other':
        # 「其他」只统计真需要人工判断的材料；系统通知/已截止活动不再成表
        subset = [r for r in subset if r.get('verdict') not in ('不涉及', '活动已截止（2026-10-27），不再收集')]
        if not subset:
            stale = os.path.join(folder, fname)
            if os.path.exists(stale):
                try:
                    os.remove(stale)
                except Exception:
                    pass
    if not subset:
        continue
    wb = Workbook()
    counts = add_summary_sheet(wb, subset, title, '%s　生成时间：%s　共 %d 封' % (subtitle, now_text, len(subset)))
    if key == 'kejian':
        add_kejian_sheet(wb, subset)
    if key == 'qianwen':
        add_qianwen_sheet(wb, subset)
    add_rules_sheet(wb, '课间一刻钟AI应用案例' if key == 'kejian' else ('千问试用人员信息表' if key == 'qianwen' else '其他'))
    path = save_book(wb, os.path.join(folder, fname))
    saved.append({'key': key, 'file': path, 'rows': len(subset), 'verdicts': counts})

# 口径（用户 m01546）：汇总表不做「一张大表」，一类材料一张，各自放进该类型的文件夹
print(json.dumps({'saved': saved, 'rows': len(rows)}, ensure_ascii=False))
